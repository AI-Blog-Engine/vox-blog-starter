# Your public key from VOX: app.vox.bd → Settings → Public API → Create a public key (starts with be_pub_).
# Server-side only: it never reaches the browser.
VOX_API_KEY=

# The VOX Blog API (leave as is unless you run your own BlogEngine).
VOX_API_URL=https://api.vox.bd

# This blog's own address, used for canonical URLs, the sitemap and RSS. No trailing slash.
SITE_URL=http://localhost:3000

# Shown in the header, page titles and feeds.
SITE_NAME=My Blog
SITE_DESCRIPTION=Articles, guides and notes.

# Optional: the signing secret of a VOX webhook pointing at /api/revalidate, so new posts appear instantly.
VOX_WEBHOOK_SECRET=

# Optional: true = use the canonical URL stored in VOX instead of SITE_URL/blog/<slug>.
VOX_USE_API_CANONICAL=false

# Optional: this site's languages, comma separated, first = primary (e.g. bn,en). Only needed when VOX does not report
# them yet (GET /public/v1/site); otherwise the blog reads them from VOX. Unset = one language, the newest post's.
VOX_LANGUAGES=
